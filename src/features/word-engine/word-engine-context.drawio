        <mxCell id="w_store" value="&lt;b&gt;playerStore&lt;/b&gt;&lt;br&gt;loadPlayer() · recordMatch()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;serializes saves; new player = empty stats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="web">
