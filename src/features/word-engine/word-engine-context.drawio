        <mxCell id="w_versus" value="&lt;b&gt;Versus&lt;/b&gt; · useVersusRace()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;types the server's word list · wordBankSource 'server'&lt;br&gt;keystrokes not fed to the engine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="web">
