<mxfile host="app.diagrams.net">
  <diagram id="word-engine-context" name="Word Engine Context">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== Center: Word Engine ===================== -->
        <mxCell id="engine" value="Word Engine&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;web/src/features/word-engine · pure TS · no network, storage or UI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;verticalAlign=top;fontStyle=1;fontSize=15;spacingTop=6;container=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="340" width="400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="e_build" value="&lt;b&gt;1. Build&lt;/b&gt;&lt;br&gt;getWordBank()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;60% weak-bigram targeted · 40% top-3000 common&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="20" y="55" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_mode" value="&lt;b&gt;Mode&lt;/b&gt;&lt;br&gt;computeBaselines() → pickMode()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;beginner · cold_start · speed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="20" y="125" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_weak" value="&lt;b&gt;Weakness&lt;/b&gt;&lt;br&gt;bigramWeakness()&lt;br&gt;scoreWord()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;internal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;dashed=1;" vertex="1" parent="engine">
          <mxGeometry x="210" y="125" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_learn" value="&lt;b&gt;2. Learn&lt;/b&gt;&lt;br&gt;cleanKeystrokes() → updateStats()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="20" y="210" width="360" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e_report" value="&lt;b&gt;3. Report&lt;/b&gt;&lt;br&gt;getFeedback()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="20" y="270" width="360" height="45" as="geometry" />
        </mxCell>

        <!-- ===================== Top: Supabase ===================== -->
        <mxCell id="supa" value="Supabase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#1F9D63;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#1F9D63;container=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="30" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s_words" value="&lt;b&gt;public.words&lt;/b&gt;&lt;br&gt;9,048 rows · rank-ordered&lt;br&gt;RLS: read by anon + authenticated&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;db/words/schema.sql&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F9D63;fontSize=11;" vertex="1" parent="supa">
          <mxGeometry x="20" y="40" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_auth" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;auth.getUser()&lt;br&gt;→ userId&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;falls back to 'local'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F9D63;fontSize=11;" vertex="1" parent="supa">
          <mxGeometry x="225" y="40" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s_player" value="&lt;b&gt;word_engine.player_data&lt;/b&gt;&lt;br&gt;&lt;i&gt;exists, 0 rows, no client access&lt;/i&gt;&lt;br&gt;account_id, net_wpm, net_accuracy,&lt;br&gt;bigram_stats jsonb, key_stats jsonb,&lt;br&gt;recent_words text[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1F9D63;fontSize=11;dashed=1;fontColor=#666666;" vertex="1" parent="supa">
