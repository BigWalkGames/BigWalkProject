        <mxCell id="w_load" value="&lt;b&gt;loadWordBank()&lt;/b&gt;&lt;br&gt;typing/wordbank&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;caches word list once · keeps last 3 banks as recentWords&lt;br&gt;3s timeout → FALLBACK_WORDS (bypasses engine)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="web">
